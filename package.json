{
  "name": "peermusic",
  "version": "1.0.0",
  "description": "Cinematic Motion Graphics Music Video & Symbolic Visual Lyric Video Engine using Remotion and React",
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "build": "tsc --noEmit",
    "validate": "python3 scripts/validate_timeline.py src/songs/kacchi-neendein/timeline.json",
    "render": "remotion render src/index.ts KacchiNeendein-Landscape out/master_landscape.mp4",
    "render:fast": "remotion render src/index.ts KacchiNeendein-Landscape out/draft_landscape.mp4 --jpeg-quality=85 --crf=20 --concurrency=8",
    "render:max": "remotion render src/index.ts KacchiNeendein-Landscape out/master_lossless.mp4 --crf=14 --jpeg-quality=98 --concurrency=8",
    "render:vertical": "remotion render src/index.ts KacchiNeendein-Vertical out/master_vertical.mp4",
    "render:vertical:fast": "remotion render src/index.ts KacchiNeendein-Vertical out/draft_vertical.mp4 --jpeg-quality=85 --crf=20 --concurrency=8",
    "render:prores": "remotion render src/index.ts KacchiNeendein-Landscape out/master_prores.mov --codec=prores --prores-profile=hq",
    "render:roughcopy": "remotion render src/index.ts RoughCopy-Landscape out/rough_copy_landscape.mp4 --jpeg-quality=90 --crf=18 --concurrency=8",
    "render:roughcopy:vertical": "remotion render src/index.ts RoughCopy-Vertical out/rough_copy_vertical.mp4 --jpeg-quality=90 --crf=18 --concurrency=8",
    "render:roughcopy:preview": "remotion render src/index.ts RoughCopy-Landscape out/rough_copy_preview.mp4 --frames=0-1800 --jpeg-quality=85 --crf=20 --concurrency=8",
    "render:roughcopy:vertical:preview": "remotion render src/index.ts RoughCopy-Vertical out/rough_copy_vertical_preview.mp4 --frames=0-1800 --jpeg-quality=85 --crf=20 --concurrency=8",
    "still:landscape": "remotion still src/index.ts KacchiNeendein-Landscape out/still_landscape.png --frame=180",
    "still:vertical": "remotion still src/index.ts KacchiNeendein-Vertical out/still_vertical.png --frame=180"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
