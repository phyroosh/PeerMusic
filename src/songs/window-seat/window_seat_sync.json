  "structured_sections": [
    {
      "name": "Intro",
      "lines": [
        "Title: Window Seat (Safar Aur Yaadein)"
      ]
    },
    {
      "name": "Intro",
      "lines": [
        "(Rhythmic acoustic guitar mimicking train tracks, distant train horn whistle, ambient chime)"
      ]
    },
    {
      "name": "Mukhda / Chorus",
      "lines": [
        "Window seat pe baith ke maine, shehar ko chhoot-te dekha hai,",
        "Kanch pe behti boondon jaisa, waqt ko fisalte dekha hai.",
        "Ek earphone kaan mein dale, gungunata hoon puraana gaana,",
        "Raste saare aage bhaagein, par dil ko peechhe jaana hai.",
        "Haan chhoot gaya woh station peeche, jahan kabhi tu mila tha mujhe,",
        "Window seat pe baith ke maine, shehar ko chhoot-te dekha hai."
      ]
    },
    {
      "name": "Antara 1 / Verse 1",
      "lines": [
        "Khambhe taaron ke silsile mein, dhoop dhalte dekhi hai,",
        "Chai-wale ki aawazon mein, shaam dhalte dekhi hai.",
        "Platform ki bheed mein maine, tera chehra dhoondha tha,",
        "Jo lafz gale mein atke the, unhein chupke se kehna tha.",
        "Haath hilaya tha tu ne jab, main hans ke mud gaya tha magar,",
        "Aansuon ne chashme ke peechhe, poora shehar bhigoya tha!"
      ]
    },
    {
      "name": "Mukhda Reprise / Chorus",
      "lines": [
        "Window seat pe baith ke maine, shehar ko chhoot-te dekha hai,",
        "Kanch pe behti boondon jaisa, waqt ko fisalte dekha hai.",
        "Raste saare aage bhaagein, par dil ko peechhe jaana hai,",
        "Window seat pe baith ke maine, shehar ko chhoot-te dekha hai."
      ]
    },
    {
      "name": "Antara 2 / Verse 2",
      "lines": [
        "Tunnel aati hai toh kanch pe, apna hi aks dikhta hai,",
        "Har musafir ki aankhon mein, ek adhura qissa dikhta hai.",
        "Kisi ki manzil aane ko hai, kisi ka ghar chhoota hai abhi,",
        "Meri jeb mein rakhi ticket pe, tera hi naam likha hai abhi!",
        "Ticket checker ko kya samjhayein, yeh seat toh khali lagti hai,",
        "Par mere barabar mein ab bhi, teri khamoshi chalti hai."
      ]
    },
    {
      "name": "Bridge",
      "lines": [
        "Agla station aane wala hai, hawa thandi ho chali hai,",
        "Uss safar ki dhool ab dheere dheere, palkon se dhul chali hai.",
        "Tu jahan bhi ho khush rehna, yeh train aage badh rahi hai,",
        "Peechhe chhoote har lamhe ki, dastaan aage padh rahi hai...",
        "Haan safar aage badh raha hai!"
      ]
    },
    {
      "name": "Outro",
      "lines": [
        "Window seat pe baith ke...",
        "Shehar ko chhoot-te dekha hai...",
        "Khidki se aati hawa ne,",
        "Tera naam pukara hai...",
        "(Soft acoustic guitar pluck, distant train whistle fading away, quiet wind breeze)"
      ]
    }
  ]
